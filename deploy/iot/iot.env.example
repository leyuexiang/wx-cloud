# 开发环境变量模板；复制到服务器受限目录并填写真实值，不把真实环境文件提交 Git。
# 此文件采用 Bash 赋值格式；请使用单引号包裹值，值内含单引号时需正确转义。
# 数据库及 Nacos 密码留空表示尚未配置，必须在启动前填写；不是可用的默认凭据。
IOT_DB_URL='jdbc:mysql://127.0.0.1:3306/wx_iot?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&nullCatalogMeansCurrent=true'
IOT_DB_USERNAME='iot_app'
IOT_DB_PASSWORD=''
IOT_REDIS_HOST='127.0.0.1'
IOT_REDIS_PORT='6379'
IOT_REDIS_DATABASE='0'
IOT_REDIS_PASSWORD=''
IOT_NACOS_SERVER_ADDR='127.0.0.1:8848'
IOT_NACOS_USERNAME='nacos'
IOT_NACOS_PASSWORD=''
# 空命名空间为 public；若系统服务使用其他空间，请填写该空间 ID。
IOT_NACOS_NAMESPACE=''
IOT_NACOS_GROUP='DEFAULT_GROUP'
# 仅为地址示例，当前服务器尚未确认有本地 Broker；部署前改为可用的 Kafka 地址。
IOT_KAFKA_BOOTSTRAP_SERVERS='127.0.0.1:9092'
IOT_ADMIN_UI_URL='http://127.0.0.1'
# 为每个 HTTPS 连接器另行设置 IOT_WEBHOOK_... 环境变量，值至少 32 字节；不要在模板写真实密钥。
# MQTT 上行默认关闭；工作进程指定租户，SINGLE 指定连接器，DYNAMIC 动态发现多个连接器。
IOT_MQTT_ENABLED='false'
IOT_MQTT_MODE='SINGLE'
IOT_MQTT_TENANT_ID=''
IOT_MQTT_CONNECTOR_ID=''
IOT_MQTT_ALLOW_INSECURE='false'
IOT_MQTT_MAX_CONNECTIONS='64'
IOT_MQTT_CONNECT_CONCURRENCY='4'
IOT_MQTT_CONTROL_CONCURRENCY='4'
IOT_MQTT_DISCOVERY_BATCH_SIZE='32'
# DYNAMIC 模式必须清空 IOT_MQTT_CONNECTOR_ID，在上述租户范围内动态发现启用的 MQTT 连接器。
# 部署新版本前先执行连接器运行所有权字段迁移；SINGLE 与 DYNAMIC 不混合滚动部署。
# 启用前另行配置连接器 credentialRef 指定的 IOT_MQTT_... 环境变量。
# 值为包含 username/password 的 JSON；不要把真实口令写入本模板或连接器 configJson。
