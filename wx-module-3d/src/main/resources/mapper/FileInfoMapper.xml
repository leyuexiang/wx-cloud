<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.wx.module.dimensions.mapper.FileInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.iocoder.wx.module.dimensions.entity.FileInfo">
        <id column="id" property="id" />
        <result column="file_name" property="fileName" />
        <result column="file_level" property="fileLevel" />
        <result column="file_type" property="fileType" />
        <result column="parent_id" property="parentId" />
        <result column="file_size" property="fileSize" />
        <result column="upload_time" property="uploadTime" />
        <result column="upload_user_id" property="uploadUserId" />
        <result column="upload_user_name" property="uploadUserName" />
        <result column="status" property="status" />
        <result column="has_next" property="hasNext" />
        <result column="unique_id" property="uniqueId" />
        <result column="create_user" property="createUser" />
        <result column="update_user" property="updateUser" />
        <result column="org_id_path" property="orgIdPath" />
        <result column="app_id" property="appId" />
        <result column="create_time" property="createTime" />
        <result column="created_by" property="createdBy" />
        <result column="last_modified_by" property="lastModifiedBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <update id="updateHasNext">
		<![CDATA[
        update file_info a
            join(select * from (select parent_id,count(*) ct from file_info  GROUP BY parent_id ) t1 where ct>1)b
        on a.id=b.parent_id
            set has_next = 1
        ]]>
	</update>

    <update id="updateAllHasNext">
		<![CDATA[
        update file_info set has_next = 0
        ]]>
	</update>

    <update id="updateLevelUniqueId">
        update file_info
        <set>
            file_level = 2,
            unique_id = "0"
        </set>
        WHERE parent_id = ${parentId}
	</update>

</mapper>
