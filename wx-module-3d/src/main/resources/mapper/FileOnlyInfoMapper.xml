<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.wx.module.dimensions.mapper.FileOnlyInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.iocoder.wx.module.dimensions.entity.FileOnlyInfo">
        <id column="id" property="id" />
        <result column="file_name" property="fileName" />
        <result column="parent_id" property="parentId" />
        <result column="parent_name" property="parentName" />
        <result column="project_id" property="projectId" />
        <result column="file_code" property="fileCode" />
        <result column="status" property="status" />
        <result column="unique_id" property="uniqueId" />
        <result column="create_user" property="createUser" />
        <result column="update_user" property="updateUser" />
        <result column="org_id_path" property="orgIdPath" />
        <result column="app_id" property="appId" />
        <result column="create_time" property="createTime" />
        <result column="created_by" property="createdBy" />
        <result column="last_modified_by" property="lastModifiedBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <update id="updateUniqueId">
		<![CDATA[
        update wx_file_only_info set unique_id = "0" WHERE parent_id = ${parentId}
        ]]>
	</update>
</mapper>
